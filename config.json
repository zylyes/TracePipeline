{
  "input_dir": "input",
  "output_dir": "output",
  "output_prefix": "Outcrop",
  "table_stem": "O76_process",
  "outcrop": "O76",
  "process_all": true,
  "export_rose_plot": true,
  "rose_bin_width": 10.0,
  "rose_dpi": 600,
  "trace_dpi": 600,
  "rotated_trace_dpi": 600,
  "window_strategy": "auto",
  "auto_density_threshold": 5.0,
  "tangent_window_count": 3,
  "min_intersections": 5,
  "style": {
    "trace_line_color": "#000000",
    "trace_line_width": 0.85,
    "hull_line_color": "#1565C0",
    "hull_fill_alpha": 0.08,
    "circle_window_line_color": "#E65100",
    "circle_window_fill_alpha": 0.08,
    "rose_bar_color": "#C94C4C",
    "rose_bar_edge": "#7A1F1F",
    "rose_grid_color": "#d9d9d9",
    "title_font_size": 10.4,
    "node_style": "default"
  },
  "enable_node_recognition": true,
  "node_merge_tolerance": 0.01,
  "show_node_overlay": true,
  "is_dev_mode": false
}