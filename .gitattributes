# Auto-detect text vs binary
* text=auto

# Python — 强制 LF，跨平台一致
*.py text eol=lf diff=python

# 配置文件 — 强制 LF
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary file types
*.png binary
*.jpg binary
*.JPG binary
*.pdf binary
*.docx binary
*.xls binary
*.xlsx binary
*.pptx binary

# Shell scripts — always LF
*.sh text eol=lf

# Batch — always CRLF
*.bat text eol=crlf
